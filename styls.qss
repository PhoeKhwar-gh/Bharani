/* styles.qss - Fixed and Complete */
QMainWindow {
    background-color: #2c3e50;
}

/* Sidebar */
#Sidebar {
    background-color: #ffffff;
    border-right: 3px solid #e74c3c;
    padding: 15px;
}

/* All Labels */
QLabel {
    color: #2c3e50;
    font-family: "Pyidaungsu";
    font-size: 11px;
    font-weight: bold;
    padding: 5px;
}

/* Line Edit */
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #bdc3c7;
    border-radius: 5px;
    padding: 8px;
    color: #2c3e50;
    font-family: "Pyidaungsu";
    font-size: 11px;
    margin: 3px;
}

QLineEdit:focus {
    border: 2px solid #3498db;
}

/* Push Buttons */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-family: "Pyidaungsu";
    font-size: 12px;
    font-weight: bold;
    margin: 5px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1c6ea4;
}

/* Calculate Button (Special) */
#pushButton_7 {
    background-color: #e74c3c;
    font-size: 14px;
    padding: 15px;
    margin: 10px 0px;
}

#pushButton_7:hover {
    background-color: #c0392b;
}

/* Action Buttons */
#pushButton_2 { /* New */
    background-color: #2ecc71;
    text-align: left;
    padding-left: 15px;
}

#pushButton_5 { /* Save */
    background-color: #f39c12;
    text-align: left;
    padding-left: 15px;
}

#pushButton_4 { /* PDF */
    background-color: #9b59b6;
    text-align: left;
    padding-left: 15px;
}

#pushButton_6 { /* Print */
    background-color: #34495e;
    text-align: left;
    padding-left: 15px;
}

#pushButton_3 { /* Edit */
    background-color: #7f8c8d;
    padding: 5px 10px;
    font-size: 10px;
}

/* Group Box */
QGroupBox {
    font-family: "Pyidaungsu";
    font-size: 12px;
    font-weight: bold;
    color: #e74c3c;
    border: 2px solid #e74c3c;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    background-color: #f8f9fa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0px 10px;
    background-color: #e74c3c;
    color: white;
    border-radius: 4px;
}

/* Radio Buttons */
QRadioButton {
    color: #2c3e50;
    font-family: "Pyidaungsu";
    font-size: 12px;
    font-weight: bold;
    spacing: 8px;
    padding: 5px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #3498db;
}

QRadioButton::indicator:checked {
    background-color: #3498db;
}

/* Combo Box */
QComboBox {
    background-color: white;
    border: 2px solid #bdc3c7;
    border-radius: 5px;
    padding: 8px;
    color: #2c3e50;
    font-family: "Pyidaungsu";
    min-height: 30px;
}

QComboBox::drop-down {
    border: none;
    background-color: #3498db;
    width: 25px;
}

QComboBox:hover {
    border: 2px solid #3498db;
}

/* Frames */
#CFrame {
    background-color: white;
    border: 2px solid #3498db;
    border-radius: 8px;
}

#RFrame {
    background-color: #ecf0f1;
    border: 2px solid #2ecc71;
    border-radius: 8px;
}

/* Menu Bar */
QMenuBar {
    background-color: #2c3e50;
    color: white;
    font-family: "Pyidaungsu";
    padding: 5px;
}

QMenuBar::item:selected {
    background-color: #3498db;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #ecf0f1;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #3498db;
    border-radius: 6px;
}

/* Tool Tip */
QToolTip {
    background-color: #2c3e50;
    color: white;
    border: 1px solid #3498db;
    padding: 5px;
    font-family: "Pyidaungsu";
}